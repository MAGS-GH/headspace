<Window x:Class="Aandehul.Companion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aandehul"
        Title="Pebble · Åndehul" Width="218" Height="224" WindowStyle="None"
        AllowsTransparency="True" Topmost="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" Foreground="#32483C">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Name="Surface" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" CornerRadius="12"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E7EDDE" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#4E6949" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#D5E2CA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="6">
    <Grid.ContextMenu>
      <ContextMenu x:Name="Options" Opened="OptionsOpened">
        <MenuItem Header="Åbn Åndehul" Click="OpenStudioClick" />
        <MenuItem x:Name="GreetMenu" Header="Hils på Pebble" Click="GreetClick" />
        <MenuItem x:Name="SessionMenu" Header="Træk vejret i ét minut" Click="ToggleClick" />
        <MenuItem x:Name="EndMenu" Header="Afslut pausen" Click="EndClick" />
        <MenuItem x:Name="VoiceMenu" Header="Læs Pebbles ord højt" IsCheckable="True" IsChecked="True" Click="VoiceClick" />
        <MenuItem x:Name="MotionMenu" Header="Begræns bevægelse" IsCheckable="True" Click="MotionClick" />
        <Separator />
        <MenuItem Header="Skjul Pebble" Click="HideClick" />
        <MenuItem Header="Afslut Åndehul" Click="QuitClick" />
      </ContextMenu>
    </Grid.ContextMenu>
    <Grid.RowDefinitions>
      <RowDefinition Height="60" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1" IsHitTestVisible="False">
      <Border Margin="0,0,0,6" Background="#FFFBF2" BorderBrush="#B7C0AD" BorderThickness="1"
              CornerRadius="15" Padding="11,5" MaxWidth="199">
        <TextBlock x:Name="SpeechBubble" Foreground="#344838" FontSize="13" LineHeight="17"
                   TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </Border>
      <Path Data="M0,0 L7,7 L13,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Fill="#FFFBF2" Stroke="#B7C0AD" StrokeThickness="1" />
    </Grid>
    <local:PebblePortrait Grid.Row="1" x:Name="Portrait" HorizontalAlignment="Center"
           Cursor="Hand" MouseLeftButtonDown="PebbleDown" MouseLeftButtonUp="PebbleUp"
           MouseMove="PebbleMove" LostMouseCapture="PebbleLostCapture"
           ToolTip="Klik for en pause. Træk for at flytte Pebble." AutomationProperties.Name="Pebble" />
    <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,3"
            Background="#FFFCF4" BorderBrush="#B7C0AD" BorderThickness="1"
            CornerRadius="16" Padding="2">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="···" FontSize="17" Width="29"
                ToolTip="Pebbles menu" AutomationProperties.Name="Pebbles menu" Click="OptionsClick" />
        <Button x:Name="SessionButton" Padding="10,3" MinHeight="29" Click="ToggleClick"
                FontSize="13" FontWeight="SemiBold" Content="Tag en rolig pause" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
